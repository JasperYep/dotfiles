#!/usr/bin/env bash

set -eu

# Search the home directory with fd, pruning hidden and bulky directories while
# keeping standalone hidden files searchable. Rofi handles fuzzy matching.
selection="$({
    fd --hidden \
        --ignore-file <(printf '%s\n' '**/.*/') \
        --type f \
        --type d \
        --exclude .git \
        --exclude .cache \
        --exclude node_modules \
        --exclude .npm \
        --exclude Trash \
        . "$HOME"
} | rofi -dmenu \
    -i \
    -sorting-method fzf \
    -no-custom \
    -p 'Open' \
    -mesg 'Search files and directories')" || exit 0

[ -n "$selection" ] || exit 0

# xdg-open handles both regular files and directories.
nohup xdg-open "$selection" >/dev/null 2>&1 &
