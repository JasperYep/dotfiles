font=Inter 11
border-size=1
border-radius=8
padding=12
margin=8
width=320
max-icon-size=24
icon-border-radius=4

# Hierarchy: source (small/secondary) > summary (bold/primary) > body (secondary).
format=<span size='small' foreground='#9893a5'>%a</span>\n<b>%s</b>\n<span foreground='#9893a5'>%b</span>

# Rosé Pine Dawn — base / text / subtext1 / surface1 / accent
background-color=#faf4ed
text-color=#575279
border-color=#cecacd
progress-color=over #907aa9

[urgency=high]
border-color=#ea9d34
