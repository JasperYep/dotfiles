font=Inter 11
border-size=1
border-radius=8
padding=12
margin=8
width=320
max-icon-size=24
icon-border-radius=4

# Hierarchy: source (small/secondary) > summary (bold/primary) > body (secondary).
format=<span size='small' foreground='#908caa'>%a</span>\n<b>%s</b>\n<span foreground='#908caa'>%b</span>

# Rosé Pine Moon — base / text / subtext1 / surface1 / accent
background-color=#232136
text-color=#e0def4
border-color=#56526e
progress-color=over #c4a7e7

[urgency=high]
border-color=#f6c177
