{
  "chat.fontSize": 16,
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 16,
  "markdown.copyFiles.destination": {
    "**/*": "assets/"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "chatgpt.followUpQueueMode": "steer",
  "chatgpt.composerEnterBehavior": "enter",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.disableLoginPrompt": true,
  "claudeCode.environmentVariables": [],
  "workbench.secondarySideBar.showLabels": false,
  "claudeCode.hideOnboarding": true,
  "workbench.colorCustomizations": {
    "activityBarBadge.background": "#958BCB",
    "button.background": "#69689F",
    "icon.foreground": "#6E75A4"
  },
  "workbench.preferredDarkColorTheme": "Rosé Pine Moon",
  "workbench.iconTheme": "rose-pine-symbols",
  "workbench.preferredLightColorTheme": "Rosé Pine Dawn",
  "window.autoDetectColorScheme": true
}
