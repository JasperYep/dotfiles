#!/usr/bin/env python3
"""Schedule, Pomodoro notifications, Waybar status, and terminal UI."""

from __future__ import annotations

import curses
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
import unicodedata
from typing import Any, Literal, overload

CONFIG_FILE = Path.home() / ".config" / "tt" / "schedule.json"
DATA_DIR = Path.home() / ".local" / "share" / "tt"
STATE_FILE = DATA_DIR / "state.json"
LOG_FILE = DATA_DIR / "tt.log"
LOCK_FILE = DATA_DIR / "tt.lock"
CHECK_SECONDS = 10
WAYBAR_SIGNAL = 8
VALID_URGENCIES = {"low", "normal", "critical"}
TUI_WEEKDAYS = ("MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN")
TUI_MONTHS = (
    "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
    "JUL", "AUG", "SEP", "OCT", "NOV", "DEC",
)


def log(message: str) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(f"[{stamp}] {message}\n")


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return default


def minute_of_day(value: str) -> int:
    parsed = dt.datetime.strptime(value, "%H:%M")
    return parsed.hour * 60 + parsed.minute


def validate_config(config: Any) -> None:
    if not isinstance(config, dict):
        raise ValueError("schedule root must be an object")

    blocks = config.get("blocks")
    if not isinstance(blocks, list) or not blocks:
        raise ValueError("schedule requires a non-empty blocks array")

    for index, block in enumerate(blocks):
        if not isinstance(block, dict):
            raise ValueError(f"blocks[{index}] must be an object")
        for key in ("start", "end", "name"):
            if not isinstance(block.get(key), str) or not block[key]:
                raise ValueError(f"blocks[{index}].{key} must be a non-empty string")
        start = minute_of_day(block["start"])
        end = minute_of_day(block["end"])
        if start == end:
            raise ValueError(f"blocks[{index}] start and end must differ")
        if "icon" in block and not isinstance(block["icon"], str):
            raise ValueError(f"blocks[{index}].icon must be a string")
        pomodoro = block.get("pomodoro")
        if pomodoro is not None:
            if not isinstance(pomodoro, dict):
                raise ValueError(f"blocks[{index}].pomodoro must be an object or null")
            for key in ("work", "break"):
                if not isinstance(pomodoro.get(key), int) or isinstance(pomodoro.get(key), bool) \
                    or pomodoro[key] <= 0:
                    raise ValueError(f"blocks[{index}].pomodoro.{key} must be a positive integer")

    reminders = config.get("reminders", [])
    if not isinstance(reminders, list):
        raise ValueError("reminders must be an array")
    for index, reminder in enumerate(reminders):
        if not isinstance(reminder, dict):
            raise ValueError(f"reminders[{index}] must be an object")
        for key in ("time", "title"):
            if not isinstance(reminder.get(key), str) or not reminder[key]:
                raise ValueError(f"reminders[{index}].{key} must be a non-empty string")
        minute_of_day(reminder["time"])
        if "body" in reminder and not isinstance(reminder["body"], str):
            raise ValueError(f"reminders[{index}].body must be a string")
        urgency = reminder.get("urgency", "normal")
        if urgency not in VALID_URGENCIES:
            raise ValueError(f"reminders[{index}].urgency must be low, normal, or critical")


@overload
def read_config(required: Literal[True] = True) -> dict[str, Any]: ...


@overload
def read_config(required: Literal[False]) -> dict[str, Any] | None: ...


def read_config(required: bool = True) -> dict[str, Any] | None:
    if not CONFIG_FILE.exists():
        if required:
            raise FileNotFoundError(f"private schedule not restored: {CONFIG_FILE}")
        return None
    config = load_json(CONFIG_FILE, {})
    validate_config(config)
    return config


def contains_minute(block: dict[str, Any], minute: int) -> bool:
    start = minute_of_day(block["start"])
    end = minute_of_day(block["end"])
    if end < start:
        return minute >= start or minute < end
    return start <= minute < end


def active_block(config: dict[str, Any], now: dt.datetime) -> dict[str, Any] | None:
    minute = now.hour * 60 + now.minute
    return next((block for block in config["blocks"] if contains_minute(block, minute)), None)


def elapsed_minutes(block: dict[str, Any], now: dt.datetime) -> float:
    start = minute_of_day(block["start"])
    current = now.hour * 60 + now.minute + now.second / 60
    if current < start:
        current += 1440
    return current - start


def remaining_minutes(block: dict[str, Any], now: dt.datetime) -> float:
    start = minute_of_day(block["start"])
    end = minute_of_day(block["end"])
    if end < start:
        end += 1440
    current = now.hour * 60 + now.minute + now.second / 60
    if current < start:
        current += 1440
    return max(0.0, end - current)


def pomodoro_state(block: dict[str, Any], now: dt.datetime) -> dict[str, Any] | None:
    config = block.get("pomodoro")
    if not config:
        return None
    work = config["work"]
    rest = config["break"]
    elapsed = elapsed_minutes(block, now)
    cycle_length = work + rest
    cycle = int(elapsed // cycle_length) + 1
    position = elapsed % cycle_length
    if position < work:
        return {"phase": "work", "cycle": cycle, "remaining": work - position, "total": work}
    return {"phase": "break", "cycle": cycle, "remaining": cycle_length - position, "total": rest}


def load_state() -> dict[str, Any]:
    state = load_json(STATE_FILE, {})
    return state if isinstance(state, dict) else {}


def save_state(state: dict[str, Any]) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    temporary = STATE_FILE.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    temporary.replace(STATE_FILE)


def notify(title: str, body: str, urgency: str = "normal") -> bool:
    command = ["notify-send", "-a", "tt", "-u", urgency, title, body]
    try:
        result = subprocess.run(
            command,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        log(f"notification unavailable: {title}: {body}")
        return False
    delivered = result.returncode == 0
    log(f"notification {'delivered' if delivered else 'failed'}: {title}: {body}")
    return delivered


def signal_waybar() -> None:
    try:
        subprocess.run(
            ["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "waybar"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        pass


def tick(config: dict[str, Any]) -> None:
    now = dt.datetime.now()
    today = now.strftime("%Y-%m-%d")
    block = active_block(config, now)
    state = load_state()
    changed = False

    block_key = f"{today}:{block['start']}:{block['name']}" if block else None
    if block is not None and block_key and state.get("block_key") != block_key:
        delivered = notify(
            f"{block.get('icon', '•')} {block['name']}",
            f"{block['start']}–{block['end']}",
        )
        if delivered:
            state["block_key"] = block_key
            state.pop("pomodoro_key", None)
            changed = True
            signal_waybar()

    if block:
        pomodoro = pomodoro_state(block, now)
        if pomodoro:
            pomodoro_key = f"{block_key}:{pomodoro['cycle']}:{pomodoro['phase']}"
            if state.get("pomodoro_key") != pomodoro_key:
                if pomodoro["phase"] == "work":
                    delivered = notify(
                        "专注开始",
                        f"第 {pomodoro['cycle']} 轮 · {pomodoro['total']} 分钟",
                    )
                else:
                    delivered = notify(
                        "休息开始",
                        f"第 {pomodoro['cycle']} 轮 · {pomodoro['total']} 分钟",
                        "critical",
                    )
                if delivered:
                    state["pomodoro_key"] = pomodoro_key
                    changed = True
                    signal_waybar()

    delivered_reminders = {
        key for key in state.get("delivered_reminders", [])
        if isinstance(key, str) and key.startswith(f"{today}:")
    }
    minute = now.strftime("%H:%M")
    for reminder in config.get("reminders", []):
        key = f"{today}:{reminder['time']}:{reminder['title']}"
        if reminder["time"] == minute and key not in delivered_reminders:
            if notify(
                reminder["title"],
                reminder.get("body", ""),
                reminder.get("urgency", "normal"),
            ):
                delivered_reminders.add(key)
                changed = True

    serialized_reminders = sorted(delivered_reminders)
    if state.get("delivered_reminders") != serialized_reminders:
        state["delivered_reminders"] = serialized_reminders
        changed = True
    if changed:
        save_state(state)


def bar_payload() -> dict[str, str]:
    config = read_config(required=False)
    if config is None:
        return {"text": "", "tooltip": "Private schedule not restored", "class": "tt-unconfigured"}

    now = dt.datetime.now()
    block = active_block(config, now)
    if block is None:
        return {"text": "", "tooltip": "No active schedule block", "class": "tt-idle"}

    remaining = int(remaining_minutes(block, now))
    icon = block.get("icon", "•")
    tooltip = f"{icon} {block['name']}\n{block['start']}–{block['end']}\n剩余 {remaining}m"
    pomodoro = pomodoro_state(block, now)
    if not pomodoro:
        return {"text": f"{icon} {remaining}m", "tooltip": tooltip, "class": "tt-normal"}

    phase_icon = "🧠" if pomodoro["phase"] == "work" else "☕"
    phase_name = "专注" if pomodoro["phase"] == "work" else "休息"
    pomodoro_remaining = int(pomodoro["remaining"])
    tooltip += f"\n\n{phase_name} · 第 {pomodoro['cycle']} 轮 · 剩余 {pomodoro_remaining}m"
    return {
        "text": f"{phase_icon} {pomodoro_remaining}m #{pomodoro['cycle']}",
        "tooltip": tooltip,
        "class": f"tt-{pomodoro['phase']}",
    }


def print_status() -> None:
    config = read_config()
    now = dt.datetime.now()
    block = active_block(config, now)
    if block is None:
        print("No active schedule block")
        return
    payload = bar_payload()
    print(f"{now:%H:%M:%S}  {block.get('icon', '•')} {block['name']}")
    print(f"{block['start']}–{block['end']}  remaining {int(remaining_minutes(block, now))}m")
    if payload["text"]:
        print(payload["text"])


def display_width(text: str) -> int:
    return sum(
        0 if unicodedata.combining(character)
        else 2 if unicodedata.east_asian_width(character) in {"W", "F"}
        else 1
        for character in text
    )


def truncate_width(text: str, width: int) -> str:
    if width <= 0:
        return ""
    result: list[str] = []
    used = 0
    for character in text:
        character_width = (
            0 if unicodedata.combining(character)
            else 2 if unicodedata.east_asian_width(character) in {"W", "F"}
            else 1
        )
        if used + character_width > width:
            break
        result.append(character)
        used += character_width
    return "".join(result)


def tui_put(
    window: Any,
    y: int,
    x: int,
    text: str,
    attribute: int = 0,
    max_width: int | None = None,
) -> None:
    height, width = window.getmaxyx()
    if y < 0 or y >= height or x < 0 or x >= width:
        return
    available = width - x
    if max_width is not None:
        available = min(available, max_width)
    rendered = truncate_width(text, available)
    if not rendered:
        return
    try:
        window.addstr(y, x, rendered, attribute)
    except curses.error:
        pass


def tui_right(window: Any, y: int, right: int, text: str, attribute: int = 0) -> None:
    tui_put(window, y, max(0, right - display_width(text)), text, attribute)


def tui_center(window: Any, y: int, text: str, attribute: int = 0) -> None:
    _, width = window.getmaxyx()
    tui_put(window, y, max(0, (width - display_width(text)) // 2), text, attribute)


def tui_styles() -> dict[str, int]:
    styles = {
        "primary": curses.A_NORMAL,
        "heading": curses.A_BOLD,
        "muted": curses.A_DIM,
        "accent": curses.A_BOLD,
        "past": curses.A_DIM,
    }
    if not curses.has_colors():
        return styles

    curses.start_color()
    background = -1
    try:
        curses.use_default_colors()
    except curses.error:
        background = curses.COLOR_BLACK

    if curses.COLORS >= 256:
        primary, muted, accent = 255, 245, 110
    else:
        primary, muted, accent = curses.COLOR_WHITE, curses.COLOR_WHITE, curses.COLOR_CYAN
    try:
        curses.init_pair(1, primary, background)
        curses.init_pair(2, muted, background)
        curses.init_pair(3, accent, background)
    except curses.error:
        return styles

    styles["primary"] = curses.color_pair(1)
    styles["heading"] = curses.color_pair(1) | curses.A_BOLD
    styles["muted"] = curses.color_pair(2)
    styles["accent"] = curses.color_pair(3) | curses.A_BOLD
    styles["past"] = curses.color_pair(2) | curses.A_DIM
    return styles


def block_duration_minutes(block: dict[str, Any]) -> int:
    start = minute_of_day(block["start"])
    end = minute_of_day(block["end"])
    if end < start:
        end += 1440
    return end - start


def block_progress(block: dict[str, Any], now: dt.datetime) -> float:
    duration = block_duration_minutes(block)
    if duration <= 0:
        return 0.0
    return min(1.0, max(0.0, elapsed_minutes(block, now) / duration))


def format_countdown(minutes: float) -> str:
    seconds = max(0, int(minutes * 60 + 0.999))
    hours, remainder = divmod(seconds, 3600)
    minute, second = divmod(remainder, 60)
    if hours:
        return f"{hours:02d}:{minute:02d}:{second:02d}"
    return f"{minute:02d}:{second:02d}"


def schedule_block_index(config: dict[str, Any], block: dict[str, Any] | None) -> int | None:
    if block is None:
        return None
    for index, candidate in enumerate(config["blocks"]):
        if candidate is block:
            return index
    return None


def next_schedule_block(
    config: dict[str, Any],
    block: dict[str, Any] | None,
    now: dt.datetime,
) -> dict[str, Any] | None:
    blocks: list[dict[str, Any]] = config["blocks"]
    if not blocks:
        return None
    index = schedule_block_index(config, block)
    if index is not None:
        return blocks[(index + 1) % len(blocks)]

    minute = now.hour * 60 + now.minute
    return min(blocks, key=lambda item: (minute_of_day(item["start"]) - minute) % 1440)


def draw_schedule_rows(
    window: Any,
    config: dict[str, Any],
    current: dict[str, Any] | None,
    top: int,
    left: int,
    right: int,
    row_limit: int,
    styles: dict[str, int],
) -> None:
    blocks = config["blocks"]
    if row_limit <= 0 or not blocks:
        return

    current_index = schedule_block_index(config, current)
    visible = min(row_limit, len(blocks))
    if current_index is None:
        first = 0
    else:
        first = max(0, min(current_index - visible // 2, len(blocks) - visible))

    name_x = left + 11
    end_x = right - 5
    name_width = max(1, end_x - name_x - 2)
    for row, index in enumerate(range(first, first + visible)):
        block = blocks[index]
        y = top + row
        is_current = index == current_index
        if is_current:
            style = styles["accent"]
            marker = "●"
        elif current_index is not None and index < current_index:
            style = styles["past"]
            marker = " "
        else:
            style = styles["muted"]
            marker = " "

        tui_put(window, y, left, marker, styles["accent"] if is_current else style)
        tui_put(window, y, left + 3, block["start"], style)
        tui_put(window, y, name_x, block["name"].upper(), style, name_width)
        tui_right(window, y, right, block["end"], style)


def draw_tui(
    window: Any,
    config: dict[str, Any],
    now: dt.datetime,
    styles: dict[str, int],
    config_error: str | None = None,
) -> None:
    window.erase()
    height, width = window.getmaxyx()
    if width < 46 or height < 13:
        tui_center(window, max(1, height // 2 - 1), "tt", styles["heading"])
        tui_center(window, max(2, height // 2 + 1), "terminal too small", styles["muted"])
        window.refresh()
        return

    content_width = min(84, width - 6)
    left = (width - content_width) // 2
    right = left + content_width
    footer_y = height - 2

    stamp = (
        f"{TUI_WEEKDAYS[now.weekday()]} · {now.day:02d} {TUI_MONTHS[now.month - 1]}"
        f"  {now:%H:%M:%S}"
    )
    tui_put(window, 1, left, "tt", styles["heading"])
    tui_right(window, 1, right, stamp, styles["muted"])
    tui_put(window, 2, left, "─" * content_width, styles["past"])

    current = active_block(config, now)
    next_block = next_schedule_block(config, current, now)
    tui_put(window, 4, left, "CURRENT", styles["muted"])

    if current is None:
        tui_put(window, 5, left, "NO ACTIVE BLOCK", styles["heading"])
        detail_y = 8
    else:
        tui_put(window, 5, left, current["name"].upper(), styles["heading"], content_width)
        tui_put(window, 6, left, f"{current['start']}  —  {current['end']}", styles["muted"])
        tui_right(
            window,
            6,
            right,
            f"{format_countdown(remaining_minutes(current, now))}  LEFT",
            styles["primary"],
        )

        progress = block_progress(current, now)
        percentage = int(progress * 100)
        percentage_text = f"{percentage:>3}%"
        bar_width = max(8, content_width - display_width(percentage_text) - 2)
        filled = min(bar_width, max(0, int(round(progress * bar_width))))
        tui_put(window, 8, left, "━" * filled, styles["accent"])
        tui_put(window, 8, left + filled, "─" * (bar_width - filled), styles["past"])
        tui_right(window, 8, right, percentage_text, styles["muted"])

        detail_y = 10
        pomodoro = pomodoro_state(current, now)
        if pomodoro:
            phase = "FOCUS" if pomodoro["phase"] == "work" else "BREAK"
            tui_put(
                window,
                detail_y,
                left,
                f"{phase}  ·  ROUND {pomodoro['cycle']:02d}",
                styles["accent"] if pomodoro["phase"] == "work" else styles["primary"],
            )
            tui_right(
                window,
                detail_y,
                right,
                format_countdown(pomodoro["remaining"]),
                styles["primary"],
            )
            detail_y += 1

    if next_block is not None:
        tui_put(window, detail_y, left, "NEXT", styles["muted"])
        tui_put(
            window,
            detail_y,
            left + 7,
            next_block["name"].upper(),
            styles["primary"],
            max(1, content_width - 16),
        )
        tui_right(window, detail_y, right, next_block["start"], styles["muted"])

    schedule_title_y = detail_y + 2
    rows_top = schedule_title_y + 1
    row_limit = max(0, footer_y - rows_top)
    if row_limit:
        tui_put(window, schedule_title_y, left, "TODAY", styles["muted"])
        draw_schedule_rows(
            window,
            config,
            current,
            rows_top,
            left,
            right,
            row_limit,
            styles,
        )

    if config_error:
        tui_put(window, footer_y, left, f"CONFIG  {config_error}", styles["accent"], content_width - 12)
    tui_right(window, footer_y, right, "Q  CLOSE", styles["past"])
    window.refresh()


def run_tui() -> None:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise RuntimeError("TUI requires an interactive terminal")

    def session(window: Any) -> None:
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        try:
            curses.set_escdelay(25)
        except AttributeError:
            pass
        window.keypad(True)
        window.timeout(200)
        styles = tui_styles()
        config = read_config()
        observed_mtime = CONFIG_FILE.stat().st_mtime_ns
        config_error: str | None = None

        while True:
            try:
                current_mtime = CONFIG_FILE.stat().st_mtime_ns
                if current_mtime != observed_mtime:
                    observed_mtime = current_mtime
                    try:
                        updated = read_config()
                    except (ValueError, json.JSONDecodeError) as error:
                        config_error = str(error)
                    else:
                        config = updated
                        config_error = None
            except FileNotFoundError:
                config_error = "schedule.json not found"

            draw_tui(window, config, dt.datetime.now(), styles, config_error)
            key = window.getch()
            if key in {ord("q"), ord("Q"), 27}:
                return

    curses.wrapper(session)


def run_daemon() -> None:
    config = read_config()
    observed_mtime = CONFIG_FILE.stat().st_mtime_ns
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError("tt daemon is already running") from error

        stop = False

        def request_stop(*_: object) -> None:
            nonlocal stop
            stop = True

        signal.signal(signal.SIGTERM, request_stop)
        signal.signal(signal.SIGINT, request_stop)
        log(f"daemon started pid={os.getpid()}")
        while not stop:
            current_mtime = CONFIG_FILE.stat().st_mtime_ns
            if current_mtime != observed_mtime:
                observed_mtime = current_mtime
                try:
                    updated = read_config()
                except (ValueError, json.JSONDecodeError) as error:
                    log(f"schedule reload rejected: {error}")
                else:
                    config = updated
                    log("schedule reloaded")
            tick(config)
            time.sleep(CHECK_SECONDS)
        log("daemon stopped")


def show_log(limit: int) -> None:
    if not LOG_FILE.exists():
        return
    for line in LOG_FILE.read_text(encoding="utf-8").splitlines()[-limit:]:
        print(line)


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    try:
        if command in {"status", "s"}:
            print_status()
        elif command in {"tui", "watch", "w"}:
            run_tui()
        elif command == "bar":
            print(json.dumps(bar_payload(), ensure_ascii=False))
        elif command == "daemon":
            run_daemon()
        elif command == "validate":
            read_config()
            print(f"valid: {CONFIG_FILE}")
        elif command == "log":
            show_log(int(sys.argv[2]) if len(sys.argv) > 2 else 40)
        else:
            print("usage: tt [status|tui|watch|bar|daemon|validate|log]", file=sys.stderr)
            return 2
    except KeyboardInterrupt:
        return 0
    except (FileNotFoundError, ValueError, RuntimeError, json.JSONDecodeError) as error:
        print(f"tt: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
