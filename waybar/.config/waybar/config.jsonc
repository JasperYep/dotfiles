{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 28,
    "margin-top": 6,
    "margin-bottom": 0,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "memory",
        "tray",
        "custom/tt",
        "pulseaudio"
    ],

    "custom/tt": {
        "exec": "tt bar",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "tooltip": true,
        "on-click": "ghostty --title=tt-watch -e tt watch"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d %A}",
        "interval": 60
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "on-click": "activate",
        "format": "{id}"
    },

    "memory": {
        "interval": 10,
        "format": "RAM {percentage}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "on-click": "pavucontrol",
        "format-icons": {
            "default": ["", "", ""]
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
